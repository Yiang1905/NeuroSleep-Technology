/* ================= RESET ================= */


*{

margin:0;

padding:0;

box-sizing:border-box;

}



html{

scroll-behavior:smooth;

}



body{


font-family:

-apple-system,
BlinkMacSystemFont,
"Segoe UI",
Arial,
sans-serif;



background:#05070d;


color:white;


overflow-x:hidden;

}




body::before{


content:"";


position:fixed;


inset:0;



background:


radial-gradient(

circle at 20% 20%,

rgba(0,212,255,.15),

transparent 35%

),


radial-gradient(

circle at 80% 30%,

rgba(120,80,255,.12),

transparent 35%

);



pointer-events:none;


z-index:-1;


}








/* ================= HEADER ================= */


.navbar{


position:fixed;


top:0;


left:0;


width:100%;


height:80px;



display:flex;


align-items:center;


justify-content:space-between;



padding:0 8%;



background:

rgba(5,7,13,.65);



backdrop-filter:

blur(20px);



border-bottom:

1px solid

rgba(255,255,255,.08);



z-index:1000;


}




.logo{


display:flex;


align-items:center;


gap:15px;


}





.logo img{


width:60px;


height:60px;



object-fit:contain;


display:block;


}





.logo-text{


display:flex;


flex-direction:column;


}





.logo-text strong{


font-size:26px;


font-weight:700;


letter-spacing:1px;


}




.logo-text span{


font-size:14px;


color:

rgba(255,255,255,.65);


}





.navbar nav{


display:flex;


gap:35px;


}




.navbar nav a{


text-decoration:none;


color:

rgba(255,255,255,.8);



font-size:16px;



transition:.3s;



}




.navbar nav a:hover{


color:#00d4ff;


}









/* ================= HERO ================= */



.hero{


min-height:100vh;



padding:

140px 8% 80px;



display:grid;



grid-template-columns:

1fr 1fr;



align-items:center;



gap:50px;


}




.hero-content h1{


font-size:

clamp(45px,5vw,75px);



line-height:1.1;



font-weight:800;



}





.hero-content h1 span{


background:


linear-gradient(

90deg,

#00d4ff,

#8b7cff

);



-webkit-background-clip:text;


color:transparent;


}




.hero-content p{


margin-top:35px;


font-size:20px;


line-height:1.8;



color:

rgba(255,255,255,.75);


}





.hero-buttons{


margin-top:45px;



display:flex;


gap:20px;


}





.btn{


padding:

15px 35px;



border-radius:40px;



background:

linear-gradient(

135deg,

#00d4ff,

#1677ff

);



color:white;



text-decoration:none;



font-weight:600;



transition:.3s;



}




.btn:hover{


transform:

translateY(-5px);



}





.btn.secondary{


background:

rgba(255,255,255,.08);



border:

1px solid

rgba(255,255,255,.2);



}




.hero-image{


position:relative;


}





.hero-image img{


width:100%;


border-radius:30px;


box-shadow:

0 0 80px

rgba(0,212,255,.25);



}






.floating-card{

display:none;

position:absolute;



right:-20px;


bottom:40px;



width:220px;



padding:25px;



border-radius:25px;



background:

rgba(255,255,255,.08);



backdrop-filter:

blur(20px);



border:

1px solid

rgba(255,255,255,.15);


}



.floating-card strong{


display:block;



font-size:45px;



color:#00d4ff;



}



.floating-card p{


color:

rgba(255,255,255,.7);


}/* ================= SECTION ================= */


.section{


padding:

120px 8%;


}




.dark-section{


background:


linear-gradient(

180deg,

rgba(255,255,255,.02),

transparent

);


}





.section-title{


max-width:900px;


margin:

0 auto 70px;



text-align:center;


}



.section-title h2{


font-size:55px;


line-height:1.2;


}



.section-title p{


margin-top:20px;



font-size:20px;



color:

rgba(255,255,255,.65);



}








/* ================= FEATURE MAIN ================= */



.feature-main{


display:grid;


grid-template-columns:

1fr 1fr;



align-items:center;



gap:60px;



margin-bottom:80px;


}




.feature-main img{


width:100%;



border-radius:35px;



box-shadow:

0 0 60px

rgba(0,212,255,.15);



}



.feature-main h3{


font-size:40px;



margin-bottom:25px;



}



.feature-main p{


font-size:20px;



line-height:1.8;



color:

rgba(255,255,255,.7);



}








/* ================= FEATURE CARD ================= */



.feature-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:30px;
width:100%;
margin:40px auto 0;
}

.feature-card{
background:rgba(255,255,255,.06);
border:1px solid rgba(255,255,255,.12);
border-radius:30px;
padding:30px;
transition:.4s;
text-align:center;
display:flex;
flex-direction:column;
align-items:center;
}

.feature-card:hover{
transform:translateY(-12px);
box-shadow:0 20px 50px rgba(0,212,255,.2);
}

.feature-card img{
width:100%;
height:220px;
object-fit:cover;
object-position:center;
border-radius:22px;
margin-bottom:22px;
display:block;
}

.feature-card h3{
font-size:26px;
line-height:1.35;
margin:0 0 15px;
text-align:center;
width:100%;
}

.feature-card p{
font-size:16px;
line-height:1.7;
color:rgba(255,255,255,.7);
text-align:center;
width:100%;
margin:0;
}









/* ================= HEALTH ================= */



.health-container{


display:grid;



grid-template-columns:

1fr 1fr;



gap:60px;



align-items:center;



}



.health-image img{


width:100%;



border-radius:35px;



}



.health-content h3{


font-size:42px;



margin-bottom:25px;



}



.health-content p{


font-size:20px;



line-height:1.8;



color:

rgba(255,255,255,.7);



}





.health-items{


margin-top:40px;



display:grid;



gap:20px;



}





.health-items div{


padding:25px;



background:


rgba(255,255,255,.06);



border-radius:20px;



border:


1px solid

rgba(255,255,255,.1);



}





.health-items h4{


font-size:22px;



color:#00d4ff;



margin-bottom:10px;



}





.risk-alert{


margin-top:60px;



padding:40px;



border-radius:30px;



text-align:center;



background:


linear-gradient(

135deg,

rgba(0,212,255,.15),

rgba(120,80,255,.15)

);



border:


1px solid

rgba(255,255,255,.15);



}





.risk-alert h3{


font-size:32px;



margin-bottom:15px;



}



.risk-alert p{


font-size:18px;



color:

rgba(255,255,255,.75);



}









/* ================= DASHBOARD ================= */



.dashboard-layout{


display:grid;



grid-template-columns:

1fr 1fr;



gap:60px;



align-items:center;



}





.dashboard-text h2{


font-size:50px;



margin-bottom:25px;



}





.dashboard-text p{


font-size:20px;



color:

rgba(255,255,255,.7);



}





.dashboard-list{


margin-top:40px;



display:grid;



gap:20px;



}




.dashboard-list div{


padding:20px;



background:


rgba(255,255,255,.06);



border-radius:18px;



border:


1px solid

rgba(255,255,255,.1);



}





.dashboard-list span{


color:#00d4ff;



font-weight:bold;



margin-right:15px;



}




.dashboard-image img{


width:100%;



border-radius:30px;



}/* ================= AI INTERACTION ================= */


.interaction-grid{


display:grid;


grid-template-columns:


repeat(3,1fr);



gap:30px;



}




.interaction-card{


background:


rgba(255,255,255,.06);



border-radius:30px;



padding:30px;



border:


1px solid

rgba(255,255,255,.12);



transition:.4s;



}



.interaction-card:hover{


transform:


translateY(-10px);



box-shadow:


0 20px 50px

rgba(0,212,255,.2);



}




.interaction-card h3{


font-size:28px;



margin-bottom:20px;



}




.interaction-card p{


line-height:1.7;



color:

rgba(255,255,255,.7);



}








/* ================= PLATFORM ================= */



.platform-grid{


display:grid;



grid-template-columns:

repeat(3,1fr);



gap:30px;



}




.platform-card{


background:


rgba(255,255,255,.06);



border:


1px solid

rgba(255,255,255,.12);



border-radius:30px;



padding:35px;



}




.platform-card h3{


font-size:30px;



margin-bottom:20px;



}



.platform-card p{


font-size:18px;



line-height:1.8;



color:

rgba(255,255,255,.7);



}










/* ================= CONTACT ================= */



.contact{


padding:


120px 8%;



text-align:center;



}




.contact-box{


max-width:800px;



margin:auto;



padding:50px;



border-radius:30px;



background:


rgba(255,255,255,.06);



border:


1px solid

rgba(255,255,255,.12);



backdrop-filter:


blur(20px);



}





.contact h2{


font-size:55px;



margin-bottom:35px;



}



.contact p{


font-size:20px;



line-height:2;



color:

rgba(255,255,255,.7);



}





.contact a{


color:#00d4ff;



text-decoration:none;



}











/* ================= FOOTER ================= */



footer{


width:100%;



padding:


60px 20px;



text-align:center;



background:


rgba(0,0,0,.35);



border-top:


1px solid

rgba(255,255,255,.1);



}



.footer-title{


font-size:28px;



font-weight:700;



margin-bottom:15px;



color:white;



}





footer p{


margin:10px 0;



font-size:16px;



color:

rgba(255,255,255,.6);



}









/* ================= MOBILE ================= */



@media(max-width:1000px){



.navbar{


padding:

0 5%;



}



.navbar nav{


display:none;



}




.hero{


grid-template-columns:

1fr;



padding-top:

120px;



}





.feature-main,

.health-container,

.dashboard-layout{


grid-template-columns:

1fr;



}





.feature-grid,

.interaction-grid,

.platform-grid{


grid-template-columns:


1fr;



}




.section-title h2{


font-size:40px;



}





.hero-content h1{


font-size:45px;



}




.floating-card{


right:10px;



bottom:20px;



}




}





@media(max-width:600px){



.logo img{


width:45px;



height:45px;



}




.logo-text strong{


font-size:20px;



}



.hero-buttons{


flex-direction:column;



}




.btn{


text-align:center;



}



.contact h2{


font-size:40px;



}



}/* ================= V8.0.1 FEATURE IMAGE FIX ================= */


.feature-card img{

width:100%;

height:220px;

object-fit:cover;

border-radius:22px;

margin-bottom:20px;

}






@media(max-width:1000px){


.feature-card img{

height:200px;

}


}.risk-alert img{

width:100%;

max-height:350px;

object-fit:cover;

border-radius:25px;

margin-bottom:30px;

}.feature-main img{

max-height:550px;

object-fit:cover;

}.document-card{

background:
rgba(255,255,255,0.05);

border:1px solid
rgba(255,255,255,0.15);

border-radius:20px;

padding:30px;

text-align:center;

transition:.3s;

}


.document-card:hover{

transform:translateY(-8px);

}


.document-card a{

display:inline-block;

margin-top:20px;

padding:12px 28px;

border-radius:30px;

background:#00c6ff;

color:white;

text-decoration:none;

font-weight:600;


}/* ================= INVESTOR RESOURCES ================= */

.pdf-links{

display:block;

margin-top:30px;

}


.pdf-links p{

font-size:20px;

font-weight:600;

margin-bottom:15px;

}


.pdf-links a{

display:inline-block;

margin:8px;

padding:12px 24px;

border-radius:30px;

border:1px solid rgba(255,255,255,0.3);

text-decoration:none;

}


.pdf-links a:hover{

transform:translateY(-3px);

transition:0.3s;

}/* ================= INVESTOR RESOURCES ================= */


.investor-resources{

text-align:center;

}


.resource-grid{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(280px,1fr));

gap:30px;

margin-top:50px;

}



.resource-card{

padding:35px;

border-radius:25px;

background:
rgba(255,255,255,0.06);

backdrop-filter:blur(15px);

}



.resource-card h3{

font-size:24px;

margin-bottom:15px;

}



.resource-card p{

opacity:.8;

line-height:1.6;

margin-bottom:25px;

}



.resource-card a{

display:inline-block;

padding:12px 25px;

border-radius:30px;

background:#00c6ff;

color:white;

text-decoration:none;

font-weight:600;

}



.resource-card a:hover{

opacity:.8;

}


/* ================= TECHNOLOGY FULL WIDTH FIX ================= */

#technology{
    width:100vw !important;
    max-width:none !important;
    margin-left:0 !important;
    margin-right:0 !important;
    box-sizing:border-box !important;
}

#technology .feature-grid{
    width:100% !important;
    max-width:none !important;
    grid-template-columns:repeat(3,minmax(0,1fr)) !important;
    gap:36px !important;
    margin-left:0 !important;
    margin-right:0 !important;
}

#technology .feature-card{
    width:100% !important;
    min-width:0 !important;
    box-sizing:border-box !important;
}

#technology .feature-card h3{
    font-size:26px !important;
    line-height:1.3 !important;
}

#technology .feature-card p{
    font-size:16px !important;
    line-height:1.7 !important;
}

/* ================= TECHNOLOGY FEATURE WIDTH FIX ================= */

#technology .feature-grid{
    width:100%;
    max-width:1200px;
    margin:40px auto 0;
}

#technology .feature-card{
    min-width:0;
}

@media(min-width:901px){
    #technology .feature-grid{
        grid-template-columns:repeat(3,minmax(0,1fr)) !important;
    }

    #technology{
        padding-left:4%;
        padding-right:4%;
    }
}

/* ================= V8.2 PLATFORM — FINAL CENTERED 3-COLUMN FIX ================= */
#platform .v82-platform-grid{
    width:100%;
    max-width:1200px;
    margin:40px auto 0;
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:30px;
    justify-content:center;
    align-items:stretch;
    box-sizing:border-box;
}

#platform .v82-platform-grid .feature-card{
    width:100%;
    min-width:0;
    margin:0;
    box-sizing:border-box;
}

@media(max-width:1000px){
    #platform .v82-platform-grid{
        grid-template-columns:repeat(2,minmax(0,1fr));
        max-width:900px;
    }
}

@media(max-width:600px){
    #platform .v82-platform-grid{
        grid-template-columns:1fr;
        max-width:520px;
    }
}

